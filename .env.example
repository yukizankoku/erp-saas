# Salin ke backend/.env untuk dev lokal. JANGAN commit file .env.
APP_NAME=[APP_NAME]
APP_SHORT_NAME=[APP_NAME]
ENVIRONMENT=local
# Dev lokal (infra/docker-compose.yml). Di Neon: DATABASE_URL = pooled, DATABASE_URL_DIRECT = direct.
DATABASE_URL=postgresql://erp:erp_dev_only@localhost:5432/erp
DATABASE_URL_DIRECT=postgresql://erp:erp_dev_only@localhost:5432/erp

# Web (Vite)
VITE_APP_NAME=[APP_NAME]
