# Salin ke backend/.env untuk dev lokal. JANGAN commit file .env.
APP_NAME=[APP_NAME]
APP_SHORT_NAME=[APP_NAME]
ENVIRONMENT=local
# Dev lokal (infra/docker-compose.yml). Neon: `neon env pull` menulis DATABASE_URL (pooled, host "-pooler")
# dan DATABASE_URL_UNPOOLED (direct, untuk migrasi Alembic) ke .env.local — backend membaca keduanya otomatis.
DATABASE_URL=postgresql://erp:erp_dev_only@localhost:5432/erp
DATABASE_URL_UNPOOLED=postgresql://erp:erp_dev_only@localhost:5432/erp
# 0 = NullPool (serverless/Vercel, pooling oleh PgBouncer Neon); >0 = pool aplikasi (VPS)
DATABASE_POOL_SIZE=5

# Web (Vite)
VITE_APP_NAME=[APP_NAME]
